#: src/main.c:43
#, c-format
msgid ""
"Usage: kiplay [OPTION]...\n"
"Audio and video player with tabbed playlists.\n"
"\n"
"  -c, --config FILE    settings file (default ~/.config/kiplay/kiplay.ini)\n"
"  -v, --verbose        print what is going on\n"
"  -V, --version        print the version and exit\n"
"  -h, --help           print this help and exit\n"
msgstr ""
"Uso: kiplay [OPÇÃO]...\n"
"Reprodutor de áudio e vídeo com playlists em abas.\n"
"\n"
"  -c, --config ARQ     arquivo de configuração (padrão ~/.config/kiplay/"
"kiplay.ini)\n"
"  -v, --verbose        mostra o que está acontecendo\n"
"  -V, --version        mostra a versão e sai\n"
"  -h, --help           mostra esta ajuda e sai\n"

