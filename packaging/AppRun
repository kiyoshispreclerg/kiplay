#!/bin/sh
# AppImage entry point: runs kiplay (it finds kiplay-audio next to itself).
here=$(dirname "$(readlink -f "$0")")
APPDIR=${APPDIR:-$here}
export APPDIR
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# gdk-pixbuf wants a loaders.cache with absolute paths; ours was written
# with a placeholder because the mount point changes on every run.
pixbuf=$APPDIR/usr/lib/gdk-pixbuf-2.0/2.10.0
if [ -f "$pixbuf/loaders.cache.in" ]; then
	cache=${XDG_RUNTIME_DIR:-}
	[ -d "$cache" ] && [ -w "$cache" ] || cache=$(mktemp -d)
	cache=$cache/kiplay-pixbuf-loaders.cache
	sed "s|@APPDIR@|$APPDIR|g" "$pixbuf/loaders.cache.in" > "$cache" &&
		export GDK_PIXBUF_MODULE_FILE=$cache
fi


exec "$APPDIR/usr/bin/kiplay" "$@"
